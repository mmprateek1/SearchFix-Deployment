{
  "name": "searchfix-ai",
  "version": "2.0.0",
  "description": "SearchFix AI - Issue Classification, Document Analysis & Evidence-Based Decision System (Phase 2)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=400 src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --import dotenv/config --test tests/*.test.js",
    "test:browser": "node tests/browser/server.js",
    "start:local": "node src/local.js"
  },
  "dependencies": {
    "@google/genai": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "keywords": [
    "searchfix",
    "gemini",
    "express",
    "classification",
    "pdf-analysis",
    "evidence-extraction",
    "decision-engine",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22 <27"
  }
}
